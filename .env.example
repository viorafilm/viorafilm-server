# Development defaults only. Do not use this file as-is in production.
DEBUG=1
SECRET_KEY=dev-secret-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=photoharu
POSTGRES_USER=photoharu
POSTGRES_PASSWORD=photoharu_pw
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOW_ALL=1
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8000
USE_X_FORWARDED_HOST=1
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
SESSION_COOKIE_HTTPONLY=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=43200
SESSION_EXPIRE_AT_BROWSER_CLOSE=1
SESSION_SAVE_EVERY_REQUEST=1

# Alerts
OFFLINE_THRESHOLD_SECONDS=120
ALERT_NOTIFY_COOLDOWN_SECONDS=600
ALERT_USE_SLACK=0
ALERT_NOTIFY_RECOVERY=1
ALERT_REPEAT_NOTIFICATIONS=0
ALERT_DAILY_REPORT_ENABLED=1
ALERT_DAILY_REPORT_HOUR=9
ALERT_DAILY_REPORT_MINUTE=0
ALERT_DAILY_TOP_BRANCHES=5
DEVICE_AUTO_LOCK_ENABLED=1
DEVICE_AUTO_LOCK_OFFLINE_DAYS=3
KIOSK_OFFLINE_GUARD_ENABLED=1
KIOSK_OFFLINE_GRACE_DAYS=3
KIOSK_GEMINI_API_KEY=

# Optional Email (dev uses console backend by default)
DEFAULT_FROM_EMAIL=noreply@photoharu.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10

# Share / Storage
STORAGE_BACKEND=auto
SHARE_TOKEN_TTL_HOURS=24
PRESIGNED_EXPIRES_SECONDS=600
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=viorafilm
R2_PREFIX=sessions

# Public base URL for absolute links (optional)
PUBLIC_BASE_URL=

# Kiosk OTA client behavior (Windows kiosk app)
KIOSK_APP_VERSION=kiosk-local
KIOSK_OTA_CHECK_MS=300000
KIOSK_OTA_AUTO_DOWNLOAD=0
KIOSK_OTA_DOWNLOAD_DIR=out/updates
KIOSK_OTA_AUTO_APPLY=0
KIOSK_OTA_AUTO_RESTART=0
KIOSK_OTA_RESTART_DELAY_SEC=8
KIOSK_OTA_STATE_PATH=out/ota_state.json
# Example:
# KIOSK_OTA_APPLY_CMD=powershell -ExecutionPolicy Bypass -File "deploy/windows/apply_update.ps1" -ArtifactPath "{artifact}" -Silent
KIOSK_OTA_APPLY_CMD=
